# SPDX-License-Identifier: CC0-1.0
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[justfile]
indent_size = 4

[tests/golden/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# The site follows Prettier's configuration (tabs).
[apps/**]
indent_style = tab
